{
    "properties": {
        "title": "${apptitle}"
    },
    "load": {
        "bundleLocations": [
            "localbundles",
            "bundles"
        ],
        "allowedBundles": [
            "agssearch",
            "banner",
            "basemaptoggler",
            "languagetoggler",
            "locateme",
            "locator-store",
            "map-init",
            "map-preload-2D",
            "mapnavigation",
            "measurement-2d",
            "notifier",
            "parameter-url",
            "popups-default",
            "printing",
            "result-ui",
            "scalebar",
            "search-ui",
            "selection-ui",
            "sketching",
            "splashscreen",
            "system",
            "template-seasons",
            "templatelayout",
            "theme-autumn",
            "toc",
            "toolrules",
            "toolset",
            "dn_imprintprivacy",
            "dn_timeslider"
        ],
        "i18n": [
            "bundle"
        ]
    },
    "bundles": {
        "dn_timeslider": {
            "Config": {
                "timeExtent": {
                    "start": "2005-06-08T23:00Z",
                    "end": "2005-07-06T23:00Z"
                },
                "fullTimeExtent": {
                    "start": "2005-06-08T23:00Z",
                    "end": "2005-12-31T23:00Z"
                },
                "stops": {
                    "interval": {
                        "value": 1,
                        "unit": "weeks"
                    }
                },
                "mode": "time-window",
                "loop": true,
                "playRate": 800,
                "playOnStartup": true,
                "timeVisible": false
            }
        },
        "agssearch": {
            "AutoStoreRegistration": {
                "componentEnabled": true
            }
        },
        "banner": {
            "BannerWidget": {
                "label": "Developer Network",
                "image": "resource('${app}:/assets/logo.svg')",
                "imageWidth": 150,
                "imagePosition": "above",
                "link": "http://conterra.github.io"
            }
        },
        "basemaptoggler": {
            "Config": {
                "itemStyles": {
                    "gray": "icon-thumbnail",
                    "streets": "icon-thumbnail",
                    "satellite": "icon-thumbnail",
                    "hybrid": "icon-thumbnail"
                }
            }
        },
        "map-init": {
            "Config": {
                "basemaps": [
                    {
                        "id": "gray",
                        "basemap": "gray-vector",
                        "title": "${map.basemaps.gray}",
                        "thumbnailUrl": "resource('${app}:/assets/gray.png')",
                        "selected": true
                    },
                    {
                        "id": "streets",
                        "basemap": "streets-vector",
                        "title": "${map.basemaps.streets}",
                        "thumbnailUrl": "resource('${app}:/assets/streets.png')"
                    },
                    {
                        "id": "satellite",
                        "basemap": "satellite",
                        "title": "${map.basemaps.topo}",
                        "thumbnailUrl": "resource('${app}:/assets/topo.png')"
                    },
                    {
                        "id": "hybrid",
                        "basemap": "hybrid",
                        "title": "${map.basemaps.hybrid}",
                        "thumbnailUrl": "resource('${app}:/assets/hybrid.png')"
                    }
                ],
                "map": {
                    "layers": [
                        {
                            "id": "v1_time_window",
                            "title": "Hurrikan-Tracks 2005 (Zeitfenster)",
                            "type": "AGS_DYNAMIC",
                            "url": "https://sampleserver6.arcgisonline.com/arcgis/rest/services/Hurricanes/MapServer",
                            "listMode": "hide-children",
                            "visible": true,
                            "sublayers": [
                                {
                                    "id": 1,
                                    "visible": true
                                }
                            ],
                            "timeSlider": {
                                "timeExtent": {
                                    "start": "2005-06-08T23:00Z",
                                    "end": "2005-07-06T23:00Z"
                                },
                                "fullTimeExtent": {
                                    "start": "2005-06-08T23:00Z",
                                    "end": "2005-12-31T23:00Z"
                                },
                                "stops": {
                                    "interval": {
                                        "value": 1,
                                        "unit": "weeks"
                                    }
                                },
                                "mode": "time-window",
                                "loop": true,
                                "playRate": 800,
                                "playOnStartup": true,
                                "timeVisible": false
                            }
                        },
                        {
                            "id": "v2_instant",
                            "title": "Hurrikan-Positionen 2000 (Zeitpunkt)",
                            "type": "AGS_DYNAMIC",
                            "url": "https://sampleserver6.arcgisonline.com/arcgis/rest/services/Hurricanes/MapServer",
                            "listMode": "hide-children",
                            "visible": false,
                            "sublayers": [
                                {
                                    "id": 0,
                                    "visible": true
                                }
                            ],
                            "timeSlider": {
                                "timeExtent": {
                                    "start": "2000-08-04T02:00Z",
                                    "end": "2000-08-04T02:00Z"
                                },
                                "fullTimeExtent": {
                                    "start": "2000-08-04T02:00Z",
                                    "end": "2000-10-22T20:00Z"
                                },
                                "stops": {
                                    "dates": [
                                        "2000-08-04T02:00Z",
                                        "2000-08-06T02:00Z",
                                        "2000-08-08T02:00Z",
                                        "2000-08-10T02:00Z",
                                        "2000-08-12T02:00Z",
                                        "2000-08-14T02:00Z",
                                        "2000-08-16T02:00Z",
                                        "2000-08-18T02:00Z",
                                        "2000-08-20T02:00Z",
                                        "2000-08-22T02:00Z",
                                        "2000-08-24T02:00Z",
                                        "2000-09-02T02:00Z",
                                        "2000-09-04T02:00Z",
                                        "2000-09-12T20:00Z",
                                        "2000-09-14T20:00Z",
                                        "2000-09-16T20:00Z",
                                        "2000-09-18T20:00Z",
                                        "2000-09-20T20:00Z",
                                        "2000-09-22T20:00Z",
                                        "2000-09-24T20:00Z",
                                        "2000-09-26T20:00Z",
                                        "2000-09-28T20:00Z",
                                        "2000-09-30T20:00Z",
                                        "2000-10-02T20:00Z",
                                        "2000-10-04T20:00Z",
                                        "2000-10-06T20:00Z",
                                        "2000-10-08T20:00Z",
                                        "2000-10-10T20:00Z",
                                        "2000-10-17T08:00Z",
                                        "2000-10-19T08:00Z",
                                        "2000-10-21T08:00Z",
                                        "2000-10-22T20:00Z"
                                    ]
                                },
                                "mode": "instant",
                                "loop": true,
                                "playRate": 800,
                                "playOnStartup": false,
                                "timeVisible": true
                            }
                        }
                    ]
                },
                "view": {
                    "viewmode": "2D",
                    "scale": 40000000,
                    "center": {
                        "x": -5844273,
                        "y": 6226642,
                        "spatialReference": {
                            "wkid": 3857
                        }
                    }
                }
            }
        },
        "toc": {
            "Config": {
                "showBasemaps": true,
                "showLayerLegend": true
            }
        },
        "toolrules": {
            "ToolRuleManager": {
                "_rules": {
                    "timeSliderToggleTool": {
                        "ruleSuccessProperty": "active",
                        "layerVisible": [
                            "v1_time_window"
                        ]
                    }
                }
            }
        },
        "toolset": {
            "ToolsetManager": {
                "toolsets": [
                    {
                        "id": "mapview_tools",
                        "tools": [
                            "timeSliderToggleTool",
                            "locateMeTool",
                            "zoomInTool",
                            "zoomOutTool",
                            "compassTool",
                            "restoreInitialViewTool",
                            "viewmodeSwitcherTool"
                        ],
                        "registerWidget": {
                            "widgetRole": "mapview_tools"
                        },
                        "container": "ignore",
                        "windowType": "container",
                        "cssClass": "muted",
                        "tooltipPositions": [
                            "before",
                            "above",
                            "below",
                            "after"
                        ]
                    },
                    {
                        "id": "drawer_left",
                        "title": "${tools.drawerLeft}",
                        "cssClass": "ct-main-app-menu",
                        "tools": [
                            "selection-ui-tool",
                            "sketchToggleTool",
                            "measuring_tools",
                            "printingToggleTool"
                        ],
                        "registerWidget": {
                            "widgetRole": "drawer_button"
                        },
                        "container": "ignore",
                        "windowType": "drawer_left",
                        "tooltipPositions": [
                            "after",
                            "above",
                            "below",
                            "before"
                        ]
                    },
                    {
                        "id": "measuring_tools",
                        "title": "${tools.measuring}",
                        "iconClass": "icon-editor-table",
                        "tools": [
                            "distanceMeasurement2DToggleTool",
                            "areaMeasurement2DToggleTool"
                        ],
                        "container": "ignore",
                        "registerTool": true,
                        "windowType": "menuitem",
                        "tooltipPositions": [
                            "after"
                        ]
                    }
                ]
            }
        },
        "dn_imprintprivacy": {
            "ToolHandler": {
                "imprintUrls": [
                    {
                        "locale": "de",
                        "url": "https://www.conterra.de/impressum"
                    },
                    {
                        "locale": "en",
                        "url": "https://www.con-terra.com/imprint"
                    }
                ],
                "privacyUrls": [
                    {
                        "locale": "de",
                        "url": "https://www.conterra.de/datenschutzhinweise"
                    },
                    {
                        "locale": "en",
                        "url": "https://www.con-terra.com/privacy-statements"
                    }
                ],
                "toolsetDefinition": {
                    "id": "imprintprivacyToolset",
                    "tools": [
                        "imprintTool",
                        "privacyStatementsTool"
                    ],
                    "registerWidget": {
                        "widgetRole": "footer_right"
                    },
                    "container": "ignore",
                    "windowType": "container",
                    "cssClass": "showToolLabels"
                }
            }
        }
    }
}